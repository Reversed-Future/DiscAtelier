{
  "name": "@discatelier/desktop",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:release": "tsc --noEmit && vite build --outDir dist-release/0.1.7",
    "tauri:dev": "npm run prepare:netease --prefix ../.. && tauri dev",
    "tauri:build": "npm run prepare:netease --prefix ../.. && tauri build --no-bundle",
    "tauri:release": "npm run prepare:netease --prefix ../.. && tauri build --config src-tauri/tauri.release.conf.json --bundles nsis --ci -- --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "opencc-js": "1.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
