{
  "build": {
    "beforeBuildCommand": "npm run build:release",
    "frontendDist": "../dist-release/0.1.28"
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Reversed-Future",
    "homepage": "https://github.com/Reversed-Future/DiscAtelier",
    "shortDescription": "个人实体音像收藏",
    "resources": {
      "../public/legal/": "legal/",
      "../../../LICENSE": "legal/LICENSE",
      "../../../artifacts/netease-runtime/": "netease-runtime/",
      "../../../artifacts/vlc-runtime-3.0.22/vlc-3.0.22/": "vlc/",
      "../../../artifacts/mpv-runtime/": "mpv/",
      "../../../artifacts/java-runtime-8u504b01/jdk8u504-b01-jre/": "jre/",
      "resources/aacs/": "aacs/",
      "resources/aacs/libaacs.dll": "vlc/libaacs.dll",
      "resources/aacs/libbdplus.dll": "vlc/libbdplus.dll"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "createUpdaterArtifacts": true
  }
}
