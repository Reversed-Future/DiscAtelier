{
  "name": "discatelier",
  "version": "0.1.27",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run tauri:dev -w @discatelier/desktop",
    "prototype": "node scripts/serve.mjs",
    "web": "npm run dev -w @discatelier/desktop",
    "build": "npm run build -w @discatelier/desktop",
    "desktop:build": "npm run tauri:build -w @discatelier/desktop",
    "release:build": "npm run tauri:release -w @discatelier/desktop",
    "release:notices": "node scripts/release/notices.mjs",
    "release:check": "node scripts/release/preflight.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --workspace",
    "check": "npm run build && cargo check --workspace",
    "prepare:netease": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-netease.ps1",
    "prepare:vlc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-vlc.ps1",
    "prepare:mpv": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-mpv.ps1"
  }
}
